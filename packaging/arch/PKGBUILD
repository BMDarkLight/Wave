# Maintainer: BMDarkLight <https://github.com/BMDarkLight>
#
# Builds Wave from source. For a much faster install that repackages the
# official release binary, see PKGBUILD-bin (wave-music-player-bin).

pkgname=wave-music-player
_pkgname=Wave
pkgver=0.5.0
pkgrel=1
pkgdesc="Lightweight, offline-first music player with a full CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/BMDarkLight/Wave"
license=('AGPL-3.0-or-later')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'libxdo'
  'hicolor-icon-theme'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
  'pkgconf'
)
optdepends=('libappindicator-gtk3: system tray icon support')
provides=('wave')
conflicts=('wave-music-player-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the release tarball checksum before publishing to the AUR:
#   makepkg -g >> PKGBUILD
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$_pkgname-$pkgver"
  npm ci
}

build() {
  cd "$srcdir/$_pkgname-$pkgver"
  # --no-bundle stops after the executable: the distro packaging below installs
  # the binary, desktop entry and icons itself, so a .deb/AppImage would only be
  # built and thrown away.
  npx tauri build --no-bundle
}

check() {
  cd "$srcdir/$_pkgname-$pkgver/src-tauri"
  cargo test --release --locked
}

package() {
  cd "$srcdir/$_pkgname-$pkgver"

  # One binary serves both roles: no arguments opens the GUI, arguments run the
  # CLI. Installing it as `wave` is what puts the command on PATH.
  install -Dm755 "src-tauri/target/release/wave" "$pkgdir/usr/bin/wave"

  install -Dm644 "packaging/linux/app.bmdarklight.wave.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/app.bmdarklight.wave.metainfo.xml"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  for size in 32 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/wave.png"
  done
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/wave.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/wave.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Wave
GenericName=Music Player
Comment=Lightweight offline-first music player
Exec=wave
Icon=wave
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;audio;player;mp3;flac;playlist;library;lyrics;equalizer;offline;
Terminal=false
StartupWMClass=app.bmdarklight.wave
StartupNotify=true
DESKTOP
}
