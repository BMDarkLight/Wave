[Desktop Entry]
Type=Application
Name=Wave
GenericName=Music Player
Comment=Lightweight offline-first music player
Exec=wave %F
Icon=app.bmdarklight.wave
Categories=AudioVideo;Audio;Player;Music;
MimeType=audio/mpeg;audio/flac;audio/mp4;audio/ogg;audio/opus;audio/wav;audio/aiff;audio/x-matroska;audio/webm;
Keywords=music;audio;player;mp3;flac;playlist;library;lyrics;equalizer;offline;
Terminal=false
StartupWMClass=app.bmdarklight.wave
StartupNotify=true
