<component type="desktop-application">
  <id>app.bmdarklight.wave</id>

  <name>Wave</name>
  <summary>Lightweight offline-first music player</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <developer id="app.bmdarklight">
    <name>BMDarkLight</name>
  </developer>

  <description>
    <p>
      Wave is a lightweight, cross-platform, offline-first music player. It keeps
      your local library fast to browse, runs real audio DSP, and shows synced
      lyrics — in a single portable app built on Rust, Tauri and React.
    </p>
    <p>Features:</p>
    <ul>
      <li>Local library with fast search across tracks, albums and artists</li>
      <li>Gapless playback, crossfade and a real parametric equalizer</li>
      <li>Time-synced and TTML karaoke lyrics</li>
      <li>Listening statistics for tracks, artists, albums and genres</li>
      <li>Playlists, favorites and M3U import/export</li>
      <li>An optional tier of free online catalogs, off by default</li>
      <li>A full command-line interface via the <code>wave</code> command</li>
    </ul>
  </description>

  <launchable type="desktop-id">Wave.desktop</launchable>

  <provides>
    <binary>wave</binary>
  </provides>

  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Player</category>
    <category>Music</category>
  </categories>

  <keywords>
