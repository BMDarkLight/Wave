{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave",
  "mainBinaryName": "wave",
  "version": "1.2.3",
  "identifier": "app.bmdarklight.wave",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wave",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https:; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://musicbrainz.org https://lrclib.net https://coverartarchive.org; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPCONFIG/**",
            "$APPLOCALDATA/**",
            "$RESOURCE/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "description": "MP3 audio",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC audio",
        "description": "FLAC audio",
        "mimeType": "audio/flac",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a",
          "m4b",
          "aac",
          "alac"
        ],
        "name": "MPEG-4 audio",
        "description": "MPEG-4 audio",
        "mimeType": "audio/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "Ogg audio",
        "description": "Ogg audio",
        "mimeType": "audio/ogg",
        "role": "Viewer"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "Opus audio",
        "description": "Opus audio",
        "mimeType": "audio/opus",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav",
          "wave"
        ],
        "name": "WAV audio",
        "description": "WAV audio",
        "mimeType": "audio/wav",
        "role": "Viewer"
      },
      {
        "ext": [
          "aiff",
          "aif"
        ],
        "name": "AIFF audio",
        "description": "AIFF audio",
        "mimeType": "audio/aiff",
        "role": "Viewer"
      },
      {
        "ext": [
          "mka"
        ],
        "name": "Matroska audio",
        "description": "Matroska audio",
        "mimeType": "audio/x-matroska",
        "role": "Viewer"
      },
      {
        "ext": [
          "weba"
        ],
        "name": "WebM audio",
        "description": "WebM audio",
        "mimeType": "audio/webm",
        "role": "Viewer"
      }
    ],
    "android": {
      "minSdkVersion": 24
    },
    "publisher": "BMDarkLight",
    "homepage": "https://github.com/BMDarkLight/Wave",
    "copyright": "Copyright (C) 2025 BMDarkLight",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Music",
    "shortDescription": "Lightweight offline-first music player",
    "longDescription": "Wave is a lightweight, cross-platform, offline-first music player. It keeps your local library fast to browse, runs real audio DSP, and shows synced lyrics, with an optional tier of free online catalogs that is off by default. The desktop app ships with a full command-line interface available as the `wave` command.",
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "desktopTemplate": "../packaging/linux/wave.desktop.hbs",
        "files": {
          "/usr/share/metainfo/app.bmdarklight.wave.metainfo.xml": "../packaging/linux/app.bmdarklight.wave.metainfo.xml"
        },
        "section": "sound",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ],
        "desktopTemplate": "../packaging/linux/wave.desktop.hbs",
        "files": {
          "/usr/share/metainfo/app.bmdarklight.wave.metainfo.xml": "../packaging/linux/app.bmdarklight.wave.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QzJDQjc5NDY3MzdCM0MKUldROGUzTkdlY3ZDUmpNWUUyd0JoUWpCUzMxaEk2cTFlbWpoTzg5ek9nU1lvR1Q2RzRBUHEzSHMK",
      "endpoints": [
        "https://github.com/BMDarkLight/Wave/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
