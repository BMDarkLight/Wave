{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wave",
  "mainBinaryName": "wave",
  "version": "0.5.0",
  "identifier": "app.bmdarklight.wave",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wave",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https:; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://musicbrainz.org https://lrclib.net https://coverartarchive.org; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPCONFIG/**",
            "$APPLOCALDATA/**",
            "$RESOURCE/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1,
      "autoIncrementVersionCode": true
    },
    "publisher": "BMDarkLight",
    "homepage": "https://github.com/BMDarkLight/Wave",
    "copyright": "Copyright (C) 2025 BMDarkLight",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Music",
    "shortDescription": "Lightweight offline-first music player",
    "longDescription": "Wave is a lightweight, cross-platform, offline-first music player. It keeps your local library fast to browse, runs real audio DSP, and shows synced lyrics, with an optional tier of free online catalogs that is off by default. The desktop app ships with a full command-line interface available as the `wave` command.",
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "desktopTemplate": "../packaging/linux/wave.desktop.hbs",
        "files": {
          "/usr/share/metainfo/app.bmdarklight.wave.metainfo.xml": "../packaging/linux/app.bmdarklight.wave.metainfo.xml"
        },
        "section": "sound",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ],
        "desktopTemplate": "../packaging/linux/wave.desktop.hbs",
        "files": {
          "/usr/share/metainfo/app.bmdarklight.wave.metainfo.xml": "../packaging/linux/app.bmdarklight.wave.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
