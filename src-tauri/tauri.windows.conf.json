{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wave",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../packaging/windows/wave.cmd": "bin/wave.cmd",
      "../packaging/windows/wave-path.ps1": "bin/wave-path.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "../packaging/windows/installer-hooks.nsh",
        "installMode": "both"
      }
    }
  }
}
